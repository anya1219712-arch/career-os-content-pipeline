# Скопируй в .env и заполни. Файл .env в git не попадает.

# Telegram
BOT_TOKEN=            # токен от @BotFather
BOT_USERNAME=osresume_bot
EDITOR_CHAT_ID=       # чат редакторов, куда приходят черновики (число, для групп со знаком минус)
EDITOR_IDS=           # id редакторов через запятую: только они могут утверждать

# Модели: Selectel Token Factory (OpenAI-совместимый API). Адрес и ключ — в панели Selectel.
# Без LLM_API_KEY работает заглушка: удобно для демо и тестов, токены не тратятся.
LLM_BASE_URL=
LLM_API_KEY=
# Резерв: Cloud.ru Evolution Foundation Models или Yandex AI Studio (тоже OpenAI-совместимые)
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=

# Модели по шагам — гипотеза, уточняем тестом (README → «Выбор моделей»). Названия — как в каталоге провайдера.
MODEL_CHEAP=Qwen-3.8-Flash-Next
MODEL_DRAFT=Qwen-3.8-Flash-Next
MODEL_REVIEW=DeepSeek-V4-Flash

# Правила
RETENTION_DAYS=30
MAX_POSTS_PER_WEEK=5
SPECIAL_PER_WEEK=1
TZ_NAME=Europe/Moscow

# Ролики (необязательно): голос Yandex SpeechKit, без ключа — ролики с субтитрами
SPEECHKIT_API_KEY=
SPEECHKIT_FOLDER_ID=
SPEECHKIT_VOICE=alena
REELS_PER_HERO=3
REELS_PER_WEEK=7
